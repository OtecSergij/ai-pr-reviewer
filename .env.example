# --- App ---
# Public origin of the app. Used as metadataBase for the absolute OpenGraph /
# Twitter card and icon URLs. Empty → http://localhost:3000 (local dev). In
# production: https://reviewer.zablotsky.dev
APP_URL=

# --- GitHub ---
# Server-side token for reviewing PUBLIC PRs (also raises GitHub's rate limit).
# Scope it to public repositories only (classic PAT: public_repo) so it cannot
# read private repos — the in-code private-PR gate is then a safety net, not the
# sole defense.
# Private PRs use the user's own PAT, passed per request — not this variable.
GITHUB_PAT=

# --- LLM providers (free fallback chain, ordered by ascending TPM budget) ---
# Groq / openai/gpt-oss-120b — default provider (free tier; its 8k-TPM cap makes
# it hand off after the first steps, deliberately showcasing the failover chain).
GROQ_API_KEY=
# Cerebras / gpt-oss-120b — first fallback. Same open weights as the Groq link
# above; the point of the hop is a separate provider and a separate quota bucket
# (30k TPM on the Cerebras trial), not a different model.
CEREBRAS_API_KEY=
# Google / gemini-2.5-flash — last fallback, big-context safety net (free tier).
GOOGLE_GENERATIVE_AI_API_KEY=
# Anthropic premium runs on the user's BYO key, passed per request — NOT from env.

# --- Dev ---
# Empty or "0" — normal behavior (real reviews, needs the provider keys above);
# any other value fails startup validation. "1" — /api/review streams a fixture
# mock WITHOUT any keys (keyless dev/demo, the LLM is never called); paste
# https://github.com/vercel/ms/pull/35 into the form.
MOCK_REVIEW=
# Only applies when MOCK_REVIEW=1; ignored otherwise (on its own it cannot
# change a real review, so a stray "1" here is inert rather than fatal).
# MOCK_REVIEW=1 alone mocks ONLY the LLM: the review still calls github.com
# anonymously — 60 requests per hour per IP, shared by everyone behind that IP —
# and it reads whichever PR was pasted, so the canned tool calls and the fetched
# PR disagree. "1" — GitHub is served from a canned vercel/ms#35 fixture
# instead, which is what makes stage-1 testing network-free: no GitHub token, no
# GitHub rate limit, any PR URL that parses works, and the same URL always
# yields the same review.
MOCK_OFFLINE=
# Only applies when MOCK_REVIEW=1; ignored otherwise, so a stray "1" in a
# production env cannot turn fake reviews into saved artifacts. Empty — a mock
# review is never persisted (the save is skipped with reason "mock"), so no
# share link is ever created; the "not saved" notice is unaffected by this flag
# and still shows for stopped and private runs. "1" — a mock review is saved
# exactly like a real one: it writes a real row into the reviews table, gets a
# share slug and a working /r/<slug> page. Local testing only; needs
# DATABASE_URL to point at a real Postgres with the schema applied
# (npm run db:migrate). Private PRs and aborted runs are still never saved.
MOCK_PERSIST=
# Only applies when MOCK_REVIEW=1. Injects an error to exercise the UI error
# taxonomy and the provider failover. Empty — no injection. Values:
#   api-retryable    — 503, retryable; hops to the next provider.
#   retry-exhausted  — RetryError wrapping a 503.
#   api-400          — non-retryable 400.
#   api-401, api-403 — auth failure. On the free chain it hops and shows the
#                      generic "service unavailable" message; with your own
#                      Anthropic key in the form it does NOT hop and shows the
#                      key-specific message instead.
#   api-404          — the model isn't available.
#   api-413          — payload too large.
#   context-overflow — a context-length marker in the provider's response body.
#   api-429          — rate limited by the provider.
#   abort            — RetryError with reason "abort". Without a user Stop the
#                      run ends with the generic error card; a real Stop still
#                      ends it silently.
#   load-key         — the provider key is missing.
#   unknown          — a plain non-SDK error.
#   tool-outcomes    — no error: a run with one skipped and one failed tool.
#   first-only       — fails the FIRST provider attempt only, after one tool
#                      step, so the review recovers on the next candidate.
#   mid-stream       — streams up to the second reported issue, then fails, so
#                      the error lands above already-rendered issue cards.
MOCK_ERROR=
# Only applies when MOCK_REVIEW=1. Picks the fixture the mock streams. Empty —
# the default two-issue review of vercel/ms#35. Values:
#   clean            — zero issues, natural finish.
#   rich             — five issues covering every severity, a max-length body,
#                      a markdown table, a fenced suggestion.
#   duplicate        — the same issue emitted twice; the repeat is ignored.
#   long             — 26 exploration steps before the summary.
#   interleaved-text — two text blocks streamed at the same time.
#   reasoning        — reasoning chunks next to the answer text.
#   finish-length    — every attempt stops at the model's output limit
#                      (finishReason "length"). The free chain treats that like
#                      a too-large failure and hands the run to the next
#                      provider, so the console shows a failover divider per
#                      hop; cut short on the last candidate, the run ends as an
#                      unsaved "Review cut short" — no share link.
MOCK_SCENARIO=

# --- Datastores ---
# Postgres — share-URL store for public reviews.
# Local dev: docker run -d --name pr-reviewer-postgres -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=pr_reviewer -p 5432:5432 postgres:18-alpine
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pr_reviewer
# Redis — per-IP rate limiter.
# Local dev: docker run -d --name pr-reviewer-redis -p 6379:6379 redis:8-alpine
REDIS_URL=redis://localhost:6379
# "1" — client IP is taken from the rightmost X-Forwarded-For entry. Enable ONLY
# when the app is reachable exclusively through a trusted reverse-proxy (Traefik
# in Coolify). Empty — all requests share one "dev" bucket (local development).
TRUST_PROXY=
